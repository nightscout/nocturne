# The builder output (SvelteKit/Vite build) is architecture-independent JS, so
# run it natively on the build host instead of under QEMU emulation; only the
# runtime stage below is per-target-arch.
FROM --platform=$BUILDPLATFORM node:24-alpine AS builder
WORKDIR /app
# Increase Node.js heap size to avoid "JavaScript heap out of memory" in CI
ENV NODE_OPTIONS="--max-old-space-size=8192"

# The same pnpm as CI and src/Web/Dockerfile. pnpm 10 cannot read this lockfile's
# patchedDependencies (`pnpm fetch` dies on an undefined patch path).
RUN npm install -g pnpm@11.5.0

# Fetched from the lockfile alone, so a source change leaves the download layer cached.
COPY src/Web/package.json src/Web/pnpm-lock.yaml src/Web/pnpm-workspace.yaml ./
# patchedDependencies in pnpm-workspace.yaml: every install from the lockfile needs the patch files.
COPY src/Web/patches ./patches
RUN pnpm fetch

COPY src/Web/supportedLocales.json src/Web/wuchale.shared.js ./
COPY src/Web/locales ./locales
COPY src/Web/packages ./packages

RUN pnpm install --frozen-lockfile --offline

# Build workspace packages required by app
RUN pnpm --filter @nocturne/bridge run build
RUN pnpm --filter @nocturne/bot run build

# Set default build-time environment variables for SvelteKit
ENV PUBLIC_API_URL=http://localhost:1612
ENV PUBLIC_WEBSOCKET_RECONNECT_ATTEMPTS=5
ENV PUBLIC_WEBSOCKET_RECONNECT_DELAY=1000
ENV PUBLIC_WEBSOCKET_MAX_RECONNECT_DELAY=30000
ENV PUBLIC_WEBSOCKET_PING_TIMEOUT=15000
ENV PUBLIC_WEBSOCKET_PING_INTERVAL=20000

# Build the app
RUN pnpm --filter @nocturne/app run build

FROM node:24-alpine
WORKDIR /app

RUN npm install -g pnpm@11.5.0

# Copy workspace structure
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/patches ./patches
COPY --from=builder /app/packages/app/package.json ./packages/app/
COPY --from=builder /app/packages/bridge/package.json ./packages/bridge/

# Install only runtime dependencies required by the app workspace package.
# This ensures server-side imports (e.g. zod) are installed in packages/app/node_modules
# where the adapter-node build resolves modules at runtime.
#
# Pin the pnpm store to /usr/local/share/pnpm. pnpm defaults it under $HOME
# (/root under the root build user, mode 0700), which the non-root runtime
# (runAsUser 1000) cannot traverse, leaving prod deps linked there unresolvable
# at runtime. /usr/local/share is world-traversable in the base image.
RUN pnpm install --prod --frozen-lockfile --filter @nocturne/app... --store-dir /usr/local/share/pnpm

# After the install, which runs under emulation on arm64 and stays cached only while its inputs
# are manifests.
COPY --from=builder /app/packages/bridge/dist ./packages/bridge/dist

# Run from the app package directory so Node resolves dependencies from
# /app/packages/app/node_modules instead of relying on root hoisting.
WORKDIR /app/packages/app

# Copy built artifacts
COPY --from=builder /app/packages/app/build ./build

# Copy custom server that integrates WebSocket bridge, and the modules it imports
COPY --from=builder /app/packages/app/server.js ./server.js
COPY --from=builder /app/packages/app/server-origin-warning.js ./server-origin-warning.js

# Smoke test critical runtime imports used by SvelteKit server chunks.
RUN node -e "import('zod'); import('@nocturne/bridge'); import('./server-origin-warning.js')"

ENV NODE_ENV=production
ENV PORT=5173
# adapter-node caps request bodies at 512K by default, which rejects support
# issue screenshot uploads (up to 4 x 10 MB) before they reach the app. Keep in
# sync with src/Web/Dockerfile.
ENV BODY_SIZE_LIMIT=44M
EXPOSE 5173

CMD ["node", "server.js"]
