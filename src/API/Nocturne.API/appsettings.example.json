{
  // ==========================================================================
  // Nocturne API configuration.
  //
  // Copy to appsettings.Development.json (or appsettings.json) to use.
  // Secrets (Oidc:Providers:*:ClientSecret, Loop:ApnsKey,
  // etc.) should NOT live in this file — set them via user-secrets:
  //   dotnet user-secrets set "Oidc:Providers:0:ClientSecret" "..."
  // ==========================================================================

  // This file is a live configuration source in the shipped image, so an uncommented key here
  // overrides the C# default in PostgreSqlConfiguration. The tuning keys are left commented so
  // that class stays the single source of truth; uncomment one only to override it.
  "PostgreSql": {
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
    // Physical connections this instance may hold. It is shared with every other client of the
    // server — a sibling service, the migrator role, your own psql — so raise the server's
    // max_connections before raising this, or the others start getting "sorry, too many clients
    // already". The shipped compose bundle sets it to 130 in the AppHost's Postgres resource; a
    // Postgres you run yourself defaults to 100, less superuser_reserved_connections.
    // "MaxPoolSize": 100,
    // "MaxRetryCount": 3,
    // "MaxRetryDelaySeconds": 30,
    // "CommandTimeoutSeconds": 30, // client-side, per command
    // "StatementTimeoutSeconds": 30 // server-side backstop; 0 disables
  },

  // The size one tenant's data and indexes are measured against by the dbsize property: warn above
  // 60% of it, urgent above 75%. Left commented so the C# default stays the single source of truth.
  "DbSize": {
    // "MaxMiB": 2048
  },

  "Connectors": {
    "Settings": {
      // Tenant syncs in flight at once across every connector poller; each holds at least one
      // pooled connection for its duration. Lower it before lowering MaxPoolSize above.
      // "SyncSlots": 24
    }
  },

  // Authentication
  "Jwt": {
    "Issuer": "nocturne",
    "Audience": "nocturne-api",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "RefreshTokenLengthBytes": 64
  },

  "Oidc": {
    "Session": {
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "7.00:00:00",
      "RotateRefreshTokens": true
    },
    "Cookie": {
      "Domain": null,
      "Secure": true,
      "HttpOnly": true,
      "SameSite": "Lax"
    },
    "State": {
      "Lifetime": "00:15:00"
    },
    // Per-deployment OIDC providers. Client secrets via user-secrets.
    "Providers": []
  },

  // Nightscout's ENABLE list, space separated. "cors" lets browser apps on other origins read
  // /api/v1, /api/v2, /api/v3 and /pebble with token or Authorization auth (never cookies).
  // "Features": { "Enable": "cors" },

  // Base domain for subdomain tenant routing, WebAuthn, and URL construction
  "BASE_DOMAIN": "localhost:1612",

  // Predictions: None | DeviceStatus | OrefWasm (default: DeviceStatus — renders
  // prediction curves uploaded by AID systems such as Loop, AAPS, and Trio)
  "Predictions": {
    "Source": "DeviceStatus"
  },

  // Operator branding and self-service controls for managed/SaaS deployments
  "Operator": {
    "Name": null,
    "AllowSelfServiceCreation": true,
    "SlugValidationWebhookUrl": null,
    "UsernameValidationWebhookUrl": null,
    "Support": {
      "AccountBilling": null,
      "AccountPortal": null
    }
  },

  // Platform-level config for managed/SaaS deployments
  "Platform": {
    "AdminSubjectIds": []
  },

  // Loop / OpenAPS Push Notifications (Apple Push Notification Service)
  // ApnsKey, ApnsKeyId, DeveloperTeamId, PushServerEnvironment via user-secrets or the
  // Nightscout LOOP_APNS_KEY, LOOP_APNS_KEY_ID, LOOP_DEVELOPER_TEAM_ID, LOOP_PUSH_SERVER_ENVIRONMENT variables.
  "Loop": {},

  // Soft-delete data retention
  "DataRetention": {
    "SoftDeleteRetentionDays": 30,
    "MinimumRetentionDays": 7
  },

  // Audit log retention applied to every tenant that has not set its own window
  // (a per-tenant value always wins, larger or smaller). Set to 0 to keep audit
  // rows forever unless a tenant opts in.
  "Audit": {
    "DefaultReadAuditRetentionDays": 90,
    "DefaultMutationRetentionDays": 90
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.Extensions.Hosting": "Information",
      "Nocturne": "Information"
    }
  }
}
