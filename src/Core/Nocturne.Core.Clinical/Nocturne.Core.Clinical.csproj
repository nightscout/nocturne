<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Clinical calculations: glucose statistics, IOB/COB and sleep reports</Description>
    </PropertyGroup>
    <PropertyGroup>
        <!-- This project reads the clock only through an injected TimeProvider; BannedSymbols.txt
             holds it there. Scoped to this project until the rest of the tree follows. -->
        <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <AdditionalFiles Include="BannedSymbols.txt"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Nocturne.Core.Constants\Nocturne.Core.Constants.csproj"/>
        <ProjectReference Include="..\Nocturne.Core.Contracts\Nocturne.Core.Contracts.csproj"/>
        <ProjectReference Include="..\Nocturne.Core.Models\Nocturne.Core.Models.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Nocturne.Core.Clinical.Tests"/>
    </ItemGroup>
</Project>
