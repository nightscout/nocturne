{
  "name": "@nocturne/bot",
  "version": "1.0.0",
  "description": "Multi-platform messaging bot for Nocturne (Discord, Telegram, Slack, WhatsApp, Resend). Its dist needs a bundler that resolves workspace TypeScript sources.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./alert-text": {
      "types": "./dist/alert-text.d.ts",
      "default": "./dist/alert-text.js"
    },
    "./parse-dispatch": {
      "types": "./dist/alerts/parse-dispatch.d.ts",
      "default": "./dist/alerts/parse-dispatch.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot:register-discord-commands": "node dist/scripts/register-discord-commands.js",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0 --report-unused-disable-directives-severity error && tsc -b tsconfig.test.json"
  },
  "author": "Nocturne Project",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@nocturne/api-client": "workspace:*",
    "@nocturne/ui": "workspace:*",
    "chat": "4.29.0",
    "@chat-adapter/discord": "4.29.0",
    "@chat-adapter/slack": "4.29.0",
    "@chat-adapter/telegram": "4.29.0",
    "@chat-adapter/whatsapp": "4.29.0",
    "@chat-adapter/state-pg": "4.29.0",
    "@resend/chat-sdk-adapter": "^0.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nocturne/eslint-config": "workspace:*",
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "^10.3.0",
    "rimraf": "^5.0.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  }
}
