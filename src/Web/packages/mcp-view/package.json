{
  "name": "@nocturne/mcp-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The MCP Apps view Nocturne's chart tools render in: one self-contained HTML file.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --run",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0 --report-unused-disable-directives-severity error",
    "smoke": "node scripts/render-smoke.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.14.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@nocturne/charts": "workspace:*",
    "@nocturne/ui": "workspace:*",
    "d3": "^7.9.0",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "layerchart": "2.9.1",
    "svelte": "^5.57.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nocturne/eslint-config": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.6.0",
    "@vitest/browser-playwright": "^4.1.6",
    "eslint": "^10.3.0",
    "playwright": "1.60.0",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.6",
    "vitest-browser-svelte": "^2.1.1"
  }
}
