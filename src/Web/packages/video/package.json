{
	"name": "@nocturne/video",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		"./manifest.json": "./published/manifest.json",
		"./published/*": "./published/*"
	},
	"scripts": {
		"build": "pnpm --filter @nocturne/app exec svelte-kit sync && node scripts/build.js",
		"capture": "node scripts/capture-fixtures.js",
		"beats": "node scripts/beats.js",
		"check": "pnpm run build && node scripts/hyperframes.js check",
		"render": "pnpm run build && node scripts/hyperframes.js render",
		"publish": "node scripts/publish.js",
		"preview": "hyperframes preview",
		"lint": "eslint .",
		"lint:ci": "eslint . --max-warnings 0 --report-unused-disable-directives-severity error"
	},
	"devDependencies": {
		"@nocturne/app": "workspace:*",
		"@nocturne/eslint-config": "workspace:*",
		"@playwright/test": "^1.60.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"devalue": "^5.1.1",
		"eslint": "^10.3.0",
		"hyperframes": "0.8.185",
		"layerchart": "2.2.0",
		"svelte": "^5.55.5",
		"tailwindcss": "^4.3.0",
		"vite": "^8.0.12"
	}
}
