{
  "name": "@nocturne/charts",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightscout/nocturne.git",
    "directory": "src/Web/packages/charts"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./icons": {
      "types": "./src/icons/index.ts",
      "svelte": "./src/icons/index.ts",
      "default": "./src/icons/index.ts"
    },
    "./print": {
      "types": "./src/print/index.ts",
      "svelte": "./src/print/index.ts",
      "default": "./src/print/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "svelte": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./themes/nocturne.css": "./src/themes/nocturne.css"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --run",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0 --report-unused-disable-directives-severity error"
  },
  "dependencies": {
    "@nocturne/ui": "workspace:*"
  },
  "peerDependencies": {
    "@lucide/svelte": "^1.14.0",
    "d3": ">=7.0.0",
    "d3-scale": ">=4.0.0",
    "d3-time": ">=3.0.0",
    "layerchart": ">=2.0.0",
    "svelte": ">=5.0.0",
    "tailwindcss": ">=4.0.0",
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.14.0",
    "@nocturne/eslint-config": "workspace:*",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3": "^7.4.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@types/node": "^25.6.0",
    "d3": "^7.9.0",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "eslint": "^10.3.0",
    "layerchart": "2.9.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "zod": "4.4.3"
  }
}
