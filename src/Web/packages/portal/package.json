{
	"name": "@nocturne/portal",
	"version": "1.0.0",
	"type": "module",
	"description": "Nocturne Portal - Configuration wizard and documentation",
	"scripts": {
		"sdk:manifest": "node scripts/generate-sdk-manifest.mjs",
		"screenshots:sync": "node scripts/sync-screenshots.mjs",
		"dev": "node scripts/generate-sdk-manifest.mjs && node scripts/sync-screenshots.mjs && vite dev",
		"build": "node scripts/generate-sdk-manifest.mjs && node scripts/sync-screenshots.mjs && vite build",
		"preview": "vite preview",
		"check": "node scripts/generate-sdk-manifest.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "svelte-kit sync && vitest run",
		"lint": "eslint .",
		"lint:ci": "eslint . --max-warnings 574"
	},
	"devDependencies": {
		"@lucide/svelte": "^0.555.0",
		"@nocturne/cms": "workspace:*",
		"@nocturne/eslint-config": "workspace:*",
		"@nocturne/screenshots": "workspace:*",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/eslint": "^9.6.1",
		"@typescript/native-preview": "7.0.0-dev.20260504.1",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"eslint": "^10.3.0",
		"formsnap": "^2.0.1",
		"mdsvex": "^0.12.3",
		"mode-watcher": "^1.1.0",
		"rehype-slug": "^6.0.0",
		"svelte": "^5.45.4",
		"svelte-check": "^4.4.2",
		"svelte-sonner": "^1.0.7",
		"sveltekit-superforms": "^2.28.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.7",
		"typescript": "^5.8.3",
		"vite": "^7.2.6",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@nocturne/app": "workspace:*",
		"@nocturne/ui": "workspace:*",
		"marked": "^18.0.2",
		"runed": "^0.37.1",
		"zod": "^4.1.13"
	}
}
