{
	"name": "@nocturne/portal",
	"version": "1.0.0",
	"type": "module",
	"description": "Nocturne Portal - Configuration wizard and documentation",
	"scripts": {
		"sdk:manifest": "node scripts/generate-sdk-manifest.mjs",
		"screenshots:sync": "node scripts/sync-screenshots.mjs",
		"videos:sync": "node scripts/sync-videos.mjs",
		"alerts-engine": "node scripts/build-alerts-engine.mjs",
		"dev": "node scripts/generate-sdk-manifest.mjs && node scripts/sync-screenshots.mjs && node scripts/sync-videos.mjs && node scripts/build-alerts-engine.mjs --optional && vite dev",
		"build": "node scripts/generate-sdk-manifest.mjs && node scripts/sync-screenshots.mjs && node scripts/sync-videos.mjs && node scripts/build-alerts-engine.mjs && vite build",
		"check:build": "node scripts/check-build.mjs",
		"preview": "vite preview",
		"check": "node scripts/generate-sdk-manifest.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "svelte-kit sync && vitest run",
		"lint": "eslint .",
		"lint:ci": "eslint . --max-warnings 0 --report-unused-disable-directives-severity error"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.14.0",
		"@nocturne/cms": "workspace:*",
		"@nocturne/eslint-config": "workspace:*",
		"@nocturne/screenshots": "workspace:*",
		"@nocturne/video": "workspace:*",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/eslint": "^9.6.1",
		"@typescript/native-preview": "7.0.0-dev.20260504.1",
		"@vitest/coverage-v8": "4.1.6",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"eslint": "^10.3.0",
		"mdsvex": "^0.12.3",
		"mode-watcher": "^1.1.0",
		"rehype-slug": "^6.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.7",
		"typescript": "^6.0.3",
		"vite": "^8.0.12",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@nocturne/app": "workspace:*",
		"@nocturne/ui": "workspace:*",
		"water-ui": "workspace:*",
		"lucide": "^1.47.0",
		"marked": "^18.0.2",
		"zod": "^4.1.13"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
