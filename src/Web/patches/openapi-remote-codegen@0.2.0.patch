+/**
+ * Convert a primitive OpenAPI schema to a Zod schema and TS type, matching the
+ * TypeScript type the generated client declares for the same schema.
+ */
+function resolvePrimitiveSchema(schema) {
+    switch (getSchemaType(schema)) {
+        case 'string':
+            return { zodSchema: 'z.string()', tsType: 'string' };
+        case 'number':
+            return { zodSchema: 'z.number()', tsType: 'number' };
+        case 'boolean':
+            return { zodSchema: 'z.boolean()', tsType: 'boolean' };
+        case 'Date':
+            return { zodSchema: 'z.coerce.date()', tsType: 'Date' };
+        default:
+            return undefined;
+    }
+}
