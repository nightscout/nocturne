#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "Part of this rule's conditions is malformed, so it can't be saved."
msgstr "Část podmínek tohoto pravidla má neplatný formát, proto jej nelze uložit."

#: src/lib/components/alerts/conditionIssues.svelte.ts
#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "Every group needs at least one condition."
msgstr "Každá skupina musí obsahovat alespoň jednu podmínku."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A condition has no comparison chosen. Pick one and save again."
msgstr "U podmínky není zvoleno porovnání. Vyberte jej a znovu uložte."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A condition has a comparison that isn't recognised. Pick one from the list and save again."
msgstr "Podmínka obsahuje nerozpoznané porovnání. Vyberte některé ze seznamu a znovu uložte."

#: src/lib/components/alerts/conditionIssues.svelte.ts
#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A glucose condition needs a direction: above or below, rising or falling."
msgstr "Podmínka glykémie musí určovat směr: nad nebo pod hodnotou, případně vzestup nebo pokles."

#: src/lib/components/alerts/conditionIssues.svelte.ts
#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "An alert-state condition needs a state: firing, unacknowledged or acknowledged."
msgstr "Podmínka stavu upozornění musí určovat stav: aktivní, nepotvrzené nebo potvrzené."

#: src/lib/components/alerts/conditionIssues.svelte.ts
#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "An alert-state condition needs a rule chosen."
msgstr "Podmínka stavu upozornění vyžaduje výběr pravidla."

#: src/lib/components/alerts/conditionIssues.svelte.ts
#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A tracker condition needs a tracker chosen."
msgstr "Podmínka sledování vyžaduje výběr sledování."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A time-of-day condition has a time zone that isn't recognised. Pick one from its time zone list, or clear it to use the profile's, and save again."
msgstr "Podmínka podle denní doby obsahuje nerozpoznané časové pásmo. Vyberte jiné ze seznamu, nebo jej vymažte a použijte pásmo profilu, poté znovu uložte."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A “for at least” duration must be 1 minute or more."
msgstr "Doba „alespoň po dobu“ musí být alespoň 1 minuta."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A signal loss condition needs a time without readings of 1 minute or more."
msgstr "Podmínka ztráty signálu vyžaduje dobu bez měření alespoň 1 minutu."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A predicted glucose condition needs to look ahead 1 minute or more."
msgstr "Podmínka predikované glykémie musí předpovídat alespoň 1 minutu dopředu."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A condition compares a time since something against a negative number of minutes, so it would be the same every time it is checked. Use 0 or more."
msgstr "Podmínka porovnává čas od události se záporným počtem minut, takže by při každé kontrole měla stejný výsledek. Použijte hodnotu 0 nebo vyšší."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A NOT or “for at least” wrapper has nothing inside it."
msgstr "Obalení NOT nebo „alespoň po dobu“ neobsahuje žádnou podmínku."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A condition is missing a setting it needs. Fill it in and save again."
msgstr "Podmínce chybí povinné nastavení. Doplňte jej a znovu uložte."

#: src/lib/components/alerts/conditionIssues.svelte.ts
#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A time-of-day condition needs both a start and an end time."
msgstr "Podmínka podle denní doby vyžaduje čas začátku i konce."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A condition has a choice that isn't recognised. Pick one from its list and save again."
msgstr "Podmínka obsahuje nerozpoznanou volbu. Vyberte některou ze seznamu a znovu uložte."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A time-of-day condition needs its times as hours and minutes, like 09:00."
msgstr "Podmínka podle denní doby vyžaduje čas ve formátu hodin a minut, například 09:00."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A time-of-day condition starts and ends at the same time, so it would never be true. Choose different times."
msgstr "Podmínka podle denní doby začíná a končí ve stejný čas, takže by nikdy nebyla splněna. Zvolte odlišné časy."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A glucose bucket condition needs at least one bucket chosen."
msgstr "Podmínka glykemického pásma vyžaduje výběr alespoň jednoho pásma."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A day-of-week condition needs at least one day chosen."
msgstr "Podmínka dne v týdnu vyžaduje výběr alespoň jednoho dne."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "A condition needs at least one option chosen."
msgstr "Podmínka vyžaduje výběr alespoň jedné možnosti."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "Pump modes can't be checked with a “State active” condition. Use a “Pump mode” condition instead."
msgstr "Režimy pumpy nelze kontrolovat podmínkou „Aktivní stav“. Použijte místo ní podmínku „Režim pumpy“."

#: src/lib/components/alerts/conditionIssues.svelte.ts
msgid "Part of this rule's conditions has a setting its kind of condition doesn't have, so it can't be saved."
msgstr "Část podmínek pravidla obsahuje nastavení, které daný typ podmínky nepodporuje, proto pravidlo nelze uložit."

