msgstr "Tidepool (open diabetes data platform)"

#: src/routes/(legal)/privacy/+page.svelte
msgid "Nightscout (diabetes data platform)"
msgstr "Nightscout (diabetes data platform)"

#: src/routes/(legal)/privacy/+page.svelte
msgid "Others via community plugins"
msgstr "Others via community plugins"

#: src/routes/(legal)/privacy/+page.svelte
msgid "5. Optional Analytics and Error Reporting"
msgstr "5. Optional Analytics and Error Reporting"

#: src/routes/(legal)/privacy/+page.svelte
msgid "In the future, Nocturne may offer optional, opt-in features for:"
msgstr "In the future, Nocturne may offer optional, opt-in features for:"

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Error reporting:</0> Send crash reports and error logs to help us improve Nocturne"
msgstr "<0>Error reporting:</0> Send crash reports and error logs to help us improve Nocturne"

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Anonymous usage analytics:</0> Aggregated, anonymized usage statistics"
msgstr "<0>Anonymous usage analytics:</0> Aggregated, anonymized usage statistics"

#: src/routes/(legal)/privacy/+page.svelte
msgid "If we add these features:"
msgstr "If we add these features:"

#: src/routes/(legal)/privacy/+page.svelte
msgid "They will be <0>opt-in only</0> - disabled by default"
msgstr "They will be <0>opt-in only</0> - disabled by default"

#: src/routes/(legal)/privacy/+page.svelte
msgid "You'll have clear control to enable or disable them"
msgstr "You'll have clear control to enable or disable them"

#: src/routes/(legal)/privacy/+page.svelte
msgid "We'll clearly explain what data would be collected"
msgstr "We'll clearly explain what data would be collected"

#: src/routes/(legal)/privacy/+page.svelte
msgid "Data will be anonymized and aggregated when possible"
msgstr "Data will be anonymized and aggregated when possible"

#: src/routes/(legal)/privacy/+page.svelte
msgid "No health data or personally identifiable information will be included"
msgstr "No health data or personally identifiable information will be included"

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Current status:</0> As of this writing, Nocturne does not include any analytics or error reporting features."
msgstr "<0>Current status:</0> As of this writing, Nocturne does not include any analytics or error reporting features."

#: src/routes/(legal)/privacy/+page.svelte
msgid "6. Your Rights and Data Control"
msgstr "6. Your Rights and Data Control"

#: src/routes/(legal)/privacy/+page.svelte
msgid "Because you self-host Nocturne, you have complete control over your data:"
msgstr "Because you self-host Nocturne, you have complete control over your data:"

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>You own your data:</0> All data belongs to you. We make no claims to it."
msgstr "<0>You own your data:</0> All data belongs to you. We make no claims to it."

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Export anytime:</0> You can export your data at any time. It's just a PostgreSQL database - you have full access."
msgstr "<0>Export anytime:</0> You can export your data at any time. It's just a PostgreSQL database - you have full access."

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Delete anytime:</0> You can delete any or all of your data whenever you want."
msgstr "<0>Delete anytime:</0> You can delete any or all of your data whenever you want."

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Control access:</0> You decide who can access your Nocturne instance and what they can see."
msgstr "<0>Control access:</0> You decide who can access your Nocturne instance and what they can see."

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Move your data:</0> You can migrate your database to a different server or hosting provider at any time."
msgstr "<0>Move your data:</0> You can migrate your database to a different server or hosting provider at any time."

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Backup your data:</0> You're responsible for backing up your database. We recommend regular backups."
msgstr "<0>Backup your data:</0> You're responsible for backing up your database. We recommend regular backups."

#: src/routes/(legal)/privacy/+page.svelte
msgid "7. Security"
msgstr "7. Security"

#: src/routes/(legal)/privacy/+page.svelte
msgid "Nocturne is designed with security best practices:"
msgstr "Nocturne is designed with security best practices:"

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Encryption:</0> API keys and sensitive credentials are stored encrypted in the database."
msgstr "<0>Encryption:</0> API keys and sensitive credentials are stored encrypted in the database."

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>HTTPS recommended:</0> We strongly recommend running Nocturne behind HTTPS to encrypt data in transit."
msgstr "<0>HTTPS recommended:</0> We strongly recommend running Nocturne behind HTTPS to encrypt data in transit."

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Authentication:</0> User accounts are protected with password hashing (bcrypt)."
msgstr "<0>Authentication:</0> User accounts are protected with password hashing (bcrypt)."

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Open source:</0> The code is open for security review by the community."
msgstr "<0>Open source:</0> The code is open for security review by the community."

#: src/routes/(legal)/privacy/+page.svelte
msgid "<0>Your responsibility:</0> As a self-hosted application, you're responsible for:"
msgstr "<0>Your responsibility:</0> As a self-hosted application, you're responsible for:"

#: src/routes/(legal)/privacy/+page.svelte
