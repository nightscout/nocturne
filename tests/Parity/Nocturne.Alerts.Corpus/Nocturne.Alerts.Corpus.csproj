<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Support for the alert test projects: the golden corpus's models and locator, the
             engine fakes and the native-library gate. It holds no tests itself. -->
        <IsTestProject>false</IsTestProject>
        <NoWarn>$(NoWarn);NU1608;NU1605</NoWarn>
        <!-- Skip the NSwag/Zod/remote-codegen post-build pipeline that hangs off the API project. -->
        <GenerateNSwagClient>false</GenerateNSwagClient>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\src\API\Nocturne.API\Nocturne.API.csproj" />
        <!-- The native-availability gate (NativeFact/NativeTheory) derives from xunit attributes. -->
        <PackageReference Include="xunit" />
    </ItemGroup>
</Project>
