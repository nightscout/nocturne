{
  "schema_version": 1,
  "name": "glucose-freshness-trend",
  "description": "trend reads the reading's bucket only while the reading is at most 11 minutes old; one second past it is unknown",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "trend",
      "condition_params": {
        "bucket": "falling_fast"
      },
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
