{
  "schema_version": 1,
  "name": "glucose-freshness-late-arrival",
  "description": "a reading timestamped 12:00 that arrives at 12:20 is fresh on arrival, at exactly 11 minutes after it, and unknown one second later: its age runs from its arrival, not its timestamp",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value": 70
      },
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
