{
  "schema_version": 1,
  "name": "context-duplicate-keys-last-wins",
  "description": "a host sends one active_state_spans entry per (category, state) and one active_trackers entry per tracker_definition_id; when two share a key the last in the list wins, so reversing the order flips both rules",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "state_span_active",
      "condition_params": {
        "category": "Illness",
        "state": null,
        "is_active": true,
        "for_minutes": 30
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "tracker_age",
      "condition_params": {
        "tracker_definition_id": "00000000-0000-0000-0001-000000000001",
        "operator": ">=",
        "minutes": 60
      },
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
      "at": "2026-01-05T12:00:00Z",
      "context": {
        "has_ever_aps_cycled": false,
        "has_ever_pump_snapshot": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false,
        "latest_value": 100,
        "latest_timestamp": "2026-01-05T12:00:00Z",
        "last_reading_at": "2026-01-05T12:00:00Z",
        "active_state_spans": [
          {
            "category": "Illness",
            "started_at": "2026-01-05T11:00:00Z"
          },
          {
            "category": "Illness",
            "started_at": "2026-01-05T11:50:00Z"
          }
        ],
        "active_trackers": [
          {
            "tracker_definition_id": "00000000-0000-0000-0001-000000000001",
            "reference_at": "2026-01-05T10:00:00Z"
          },
          {
            "tracker_definition_id": "00000000-0000-0000-0001-000000000001",
            "reference_at": "2026-01-05T11:50:00Z"
          }
        ]
      }
    },
    {
      "at": "2026-01-05T12:05:00Z",
      "context": {
        "has_ever_aps_cycled": false,
        "has_ever_pump_snapshot": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false,
        "latest_value": 100,
        "latest_timestamp": "2026-01-05T12:05:00Z",
        "last_reading_at": "2026-01-05T12:05:00Z",
        "active_state_spans": [
          {
            "category": "Illness",
            "started_at": "2026-01-05T11:50:00Z"
          },
          {
            "category": "Illness",
            "started_at": "2026-01-05T11:00:00Z"
          }
        ],
        "active_trackers": [
          {
            "tracker_definition_id": "00000000-0000-0000-0001-000000000001",
            "reference_at": "2026-01-05T11:50:00Z"
          },
          {
            "tracker_definition_id": "00000000-0000-0000-0001-000000000001",
            "reference_at": "2026-01-05T10:00:00Z"
          }
        ]
      }
    }
  ]
}
