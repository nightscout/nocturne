{
  "schema_version": 1,
  "name": "context-duplicate-keys-last-wins",
  "description": "a host sends one active_state_spans entry per (category, state), one active_trackers entry per tracker_definition_id and one active_alerts entry per alert_id; when two share a key the last in the list wins, so reversing the order flips all three rules",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "state_span_active",
      "condition_params": {
        "schema_version": 2,
        "category": "Illness",
        "state": null,
        "is_active": true,
        "for_minutes": 30
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "tracker_age",
      "condition_params": {
        "schema_version": 2,
        "tracker_definition_id": "00000000-0000-0000-0001-000000000001",
        "operator": ">=",
        "minutes": 60
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "name": "rule-3",
      "condition_type": "alert_state",
      "condition_params": {
        "schema_version": 2,
        "alert_id": "00000000-0000-0000-0000-000000000900",
        "state": "firing",
        "for_minutes": null
      },
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
      "at": "2026-01-05T12:00:00Z",
      "context": {
        "has_ever_aps_cycled": false,
        "has_ever_pump_snapshot": false,
