{
  "schema_version": 1,
  "name": "next-change-time-of-day-dst-fold",
  "description": "Sydney repeats 02:00-03:00 on 2026-04-05: past an edge at 02:30 AEDT the fold steps the wall clock back into the window",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "time_of_day",
      "condition_params": {
        "from": "01:00",
        "to": "02:30",
        "timezone": "Australia/Sydney"
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
      "at": "2026-04-04T15:40:00Z",
      "context": {
        "has_ever_aps_cycled": false,
        "has_ever_pump_snapshot": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false
      }
    }
  ]
}
