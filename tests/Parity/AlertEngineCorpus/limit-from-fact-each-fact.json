{
  "schema_version": 1,
  "name": "limit-from-fact-each-fact",
  "description": "a glucose comparison's limit names a fact: threshold below target_low and above target_high, predicted below latest_glucose, eventual_glucose below target_low; each decides against the fact's value in its tick's context, and a true one names the limit and its fact in met_by",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value_from": {
          "fact": "target_low"
        }
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "threshold",
