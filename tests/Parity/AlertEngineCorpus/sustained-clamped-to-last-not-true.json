{
  "schema_version": 1,
  "name": "sustained-clamped-to-last-not-true",
  "description": "a suspension recorded late claims to have begun an hour before an evaluation that found the pump running: the run starts where that evaluation's 5-minute not-true lease ends, so sustained{30} holds 30 minutes after it",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "sustained",
      "condition_params": {
        "minutes": 30,
        "child": {
          "type": "pump_suspended",
          "pump_suspended": {
            "is_active": true
          }
        }
      }
    }
  ],
  "ticks": [
