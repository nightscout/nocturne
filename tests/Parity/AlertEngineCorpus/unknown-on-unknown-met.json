{
  "schema_version": 1,
  "name": "unknown-on-unknown-met",
  "description": "on_unknown met reads an unknown root as true: no reading opens an excursion (12:00) and keeps it going (12:05); a known false starts hysteresis",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value": 70
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 10,
      "auto_resolve_enabled": false,
      "on_unknown": "met"
    }
  ],
