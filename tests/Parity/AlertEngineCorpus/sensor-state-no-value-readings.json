{
  "schema_version": 1,
  "name": "sensor-state-no-value-readings",
  "description": "readings that arrive with no glucose value carry sensor_state no_value and no latest_value, while last_reading_at stays the last reading with a value: signal_loss fires once that reading is older than its timeout although readings still arrive, the threshold rule opened before them holds, and sensor_state over no_value is true; the next reading with a value closes the signal loss and the threshold rule continues",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "signal_loss",
      "condition_params": {
        "timeout_minutes": 15
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value": 70
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "name": "rule-3",
      "condition_type": "sensor_state",
      "condition_params": {
        "states": [
          "no_value"
        ]
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
