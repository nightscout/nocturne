{
  "schema_version": 1,
  "name": "staleness-infinity-convention",
  "description": "LastReadingAt null but LatestTimestamp set: elapsed is +infinity — > and >= true, <, <= and == false",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "staleness",
      "condition_params": {
        "schema_version": 2,
        "operator": ">",
        "minutes": 15
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "staleness",
      "condition_params": {
        "schema_version": 2,
        "operator": ">=",
        "minutes": 15
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "name": "rule-3",
      "condition_type": "staleness",
      "condition_params": {
        "schema_version": 2,
        "operator": "<",
        "minutes": 15
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000004",
      "name": "rule-4",
      "condition_type": "staleness",
      "condition_params": {
        "schema_version": 2,
        "operator": "<=",
        "minutes": 15
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000005",
      "name": "rule-5",
      "condition_type": "staleness",
      "condition_params": {
        "schema_version": 2,
        "operator": "==",
        "minutes": 15
      },
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
      "at": "2026-01-05T12:00:00Z",
      "context": {
        "latest_timestamp": "2026-01-05T11:30:00Z",
        "has_ever_aps_cycled": false,
        "has_ever_pump_snapshot": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false
      }
    }
  ]
}
