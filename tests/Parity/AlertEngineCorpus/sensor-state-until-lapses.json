{
  "schema_version": 1,
  "name": "sensor-state-until-lapses",
  "description": "a reported state counts until its until and not at it: the low threshold rule holds while the error report counts, with the report's until as its next change, and opens at that instant on the same reading; sensor_state over error is true, then unknown once the report lapses",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value": 70
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "sensor_state",
      "condition_params": {
        "states": [
          "error"
        ]
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
