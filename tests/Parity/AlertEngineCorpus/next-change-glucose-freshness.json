{
  "schema_version": 1,
  "name": "next-change-glucose-freshness",
  "description": "a fresh reading-driven leaf next changes when its reading goes stale, at the reading time plus the rule's bound; at exactly the bound the change is one tick on, and a stale leaf has none",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value": 70
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value": 70
      },
      "auto_resolve_enabled": false,
      "glucose_freshness_minutes": 20
    }
  ],
  "ticks": [
