{
  "schema_version": 1,
  "name": "limit-from-fact-offsets",
  "description": "an offset moves the fact's value: predicted more than 30 below the current value (latest_glucose, offset -30), threshold below target_low minus 10, threshold above target_high plus 20; a decimal offset is exact",
  "rules": [
