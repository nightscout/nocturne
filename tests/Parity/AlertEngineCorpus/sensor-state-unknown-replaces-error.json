{
  "schema_version": 1,
  "name": "sensor-state-unknown-replaces-error",
  "description": "a low threshold rule holds while the sensor reports an error; when the sensor next says something the host does not recognise, the host sends no state, so the low opens the excursion at once and a sensor_state rule for error is unknown rather than still true",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value": 70
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "sensor_state",
      "condition_params": {
        "states": [
          "error"
        ]
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
