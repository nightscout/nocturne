{
  "schema_version": 1,
  "name": "clear-margin-connectives",
  "description": "the margin applies under and, or and not: and and or widen with the rule while open; not over a margined leaf moves its limit to the leaf's false side, so the rule's truth widens too",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
