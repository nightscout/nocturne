{
  "schema_version": 1,
  "name": "unknown-glucose-facts",
  "description": "each glucose leaf known on the first tick and unknown on the second: no latest_value (threshold), no trend_rate (rate_of_change), no trend_bucket (trend), no glucose_bucket (glucose_bucket), and no reading history at all (staleness, signal_loss)",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value": 120
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "rate_of_change",
      "condition_params": {
        "direction": "rising",
        "rate": 0
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "name": "rule-3",
      "condition_type": "trend",
      "condition_params": {
        "bucket": "flat"
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000004",
      "name": "rule-4",
      "condition_type": "glucose_bucket",
      "condition_params": {
        "buckets": [
          "in_range"
        ]
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000005",
      "name": "rule-5",
      "condition_type": "staleness",
      "condition_params": {
        "operator": "\u003C",
        "value": 10
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000006",
      "name": "rule-6",
      "condition_type": "signal_loss",
      "condition_params": {
        "timeout_minutes": 1
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
      "at": "2026-01-05T12:00:00Z",
      "context": {
        "latest_value": 100,
        "latest_timestamp": "2026-01-05T12:00:00Z",
        "trend_rate": 0,
        "last_reading_at": "2026-01-05T12:00:00Z",
        "has_ever_aps_cycled": false,
        "has_ever_pump_snapshot": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false,
        "trend_bucket": "flat",
        "glucose_bucket": "in_range"
      }
    },
    {
      "at": "2026-01-05T12:05:00Z",
      "context": {
        "has_ever_aps_cycled": false,
