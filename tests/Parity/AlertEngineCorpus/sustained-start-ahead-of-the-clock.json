{
  "schema_version": 1,
  "name": "sustained-start-ahead-of-the-clock",
  "description": "a reading timestamped 3 minutes after now and an override that claims to start 20 minutes after now: each run starts at now, never ahead of it",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "sustained",
      "condition_params": {
        "minutes": 10,
        "child": {
          "type": "threshold",
          "threshold": {
            "direction": "below",
            "value": 70
          }
        }
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
