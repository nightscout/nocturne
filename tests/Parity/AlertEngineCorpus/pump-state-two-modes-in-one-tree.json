            "pump_state": {
              "mode": "Suspended",
              "is_active": true,
              "for_minutes": 10
            }
          },
          {
            "type": "pump_state",
            "pump_state": {
              "mode": "Automatic",
              "is_active": true,
              "for_minutes": null
            }
          }
        ]
      },
      "auto_resolve_enabled": false
    }
  ],
