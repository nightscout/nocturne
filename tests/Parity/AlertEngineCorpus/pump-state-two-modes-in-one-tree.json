{
  "schema_version": 1,
  "name": "pump-state-two-modes-in-one-tree",
  "description": "one rule holds two pump_state leaves for different modes, Suspended and Automatic, and a Suspended span runs on top of an Automatic one: both leaves are answered from the one context, so the rule is true while both spans are active and false once either ends; with the Suspended leaf over for_minutes the rule holds from the instant the suspension has lasted that long",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "composite",
      "condition_params": {
        "operator": "and",
        "conditions": [
          {
            "type": "pump_state",
            "pump_state": {
              "mode": "Suspended",
              "is_active": true,
              "for_minutes": null
            }
          },
          {
            "type": "pump_state",
            "pump_state": {
              "mode": "Automatic",
              "is_active": true,
              "for_minutes": null
            }
          }
        ]
      },
      "auto_resolve_enabled": false
    },
    {
