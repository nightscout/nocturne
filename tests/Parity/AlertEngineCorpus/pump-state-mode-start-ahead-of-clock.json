{
  "schema_version": 1,
  "name": "pump-state-mode-start-ahead-of-clock",
  "description": "a pump_state leaf reads the start of the entry for the mode it names: a Suspended span dated 30 minutes ahead of the clock makes the for_minutes leaf over Suspended unknown and the rule hold, with clock_anomaly naming active_pump_modes and next_change_at where the start comes within the tolerance, while the leaf over the Automatic span, dated behind the clock, is answered as usual; a start within the 5 minute tolerance reads as zero elapsed",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "pump_state",
      "condition_params": {
        "schema_version": 2,
        "mode": "Suspended",
        "is_active": true,
        "for_minutes": 10
      },
      "auto_resolve_enabled": false
    },
    {
