{
  "schema_version": 1,
  "name": "auto-resolve-same-tick-as-open",
  "description": "the auto-resolve pass runs unconditionally after the tracker, so a resolve predicate already true on the open tick produces opened \u002B auto-resolved in one evaluation",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "iob",
      "condition_params": {
        "operator": "\u003E=",
        "value": 3
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": true,
      "auto_resolve_params": {
        "type": "trend",
        "trend": {
          "bucket": "flat"
        }
      }
    }
  ],
  "ticks": [
    {
      "at": "2026-01-05T12:00:00Z",
      "context": {
        "latest_value": 100,
        "latest_timestamp": "2026-01-05T12:00:00Z",
        "trend_rate": 0,
        "last_reading_at": "2026-01-05T12:00:00Z",
        "trend_bucket": "flat",
        "iob_units": 4,
        "has_ever_aps_cycled": false,
        "has_ever_pump_snapshot": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false
      }
    }
  ]
}
