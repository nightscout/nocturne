{
  "schema_version": 1,
  "name": "replay-first-connect-backfill",
  "description": "a first connect at 14:00 brings in readings from 12:00 to 13:55, none from 12:30 to 13:05, all dated before the stream first sent anything, so they are replayed at their timestamps with no arrival; then the stream sends live: a 30-minute signal loss fires in the gap at 12:55, ends at 13:10, and fires again only once the live readings stop",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "signal_loss",
      "condition_params": {
        "timeout_minutes": 30
      },
      "auto_resolve_enabled": false
    }
  ],
