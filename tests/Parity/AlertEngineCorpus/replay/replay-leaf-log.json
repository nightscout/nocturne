{
  "schema_version": 1,
  "name": "replay-leaf-log",
  "description": "every leaf is logged at its first observation and each flip, evaluated alone even where the composite short-circuits",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "composite",
      "condition_params": {
        "operator": "and",
        "conditions": [
          {
            "type": "threshold",
            "threshold": {
              "direction": "below",
              "value": 70
            }
          },
          {
            "type": "iob",
            "iob": {
              "operator": "\u003E=",
              "value": 1
            }
          },
          {
            "type": "not",
            "not": {
              "child": {
                "type": "trend",
                "trend": {
                  "bucket": "flat"
                }
              }
            }
          }
        ]
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
