{
  "schema_version": 1,
  "name": "replay-signal-loss-gap",
  "description": "ticks before the first reading read as fresh, so staleness and signal_loss stay quiet there; a gap after a reading reads as stale and fires both",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "signal_loss",
      "condition_params": {
        "timeout_minutes": 15
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "staleness",
      "condition_params": {
        "operator": "\u003E=",
        "value": 10
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
