{
  "schema_version": 1,
  "name": "replay-catch-up-after-outage",
  "description": "the uploader goes quiet after 12:30 and catches up at 12:52 with the readings for 12:35 to 12:50, each a live arrival however late, evaluated where it was stored: live saw the outage until the catch-up, so a 20-minute signal loss fires at 12:50 and ends at 12:52",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "signal_loss",
      "condition_params": {
        "timeout_minutes": 20
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
