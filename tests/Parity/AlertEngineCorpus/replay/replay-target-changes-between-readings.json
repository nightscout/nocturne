{
  "schema_version": 1,
  "name": "replay-target-changes-between-readings",
  "description": "the target range changes at 07:00 between two readings: a wall-clock rule over below target_low is evaluated on the sample ticks and opens at the first one after the boundary, while the same leaf alone, which live evaluates only per reading, opens at the next reading, as live does",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "below",
        "value_from": {
          "fact": "target_low"
        }
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "composite",
      "condition_params": {
        "operator": "or",
        "conditions": [
          {
            "type": "threshold",
            "threshold": {
              "direction": "below",
              "value_from": {
                "fact": "target_low"
              }
            }
          },
          {
            "type": "signal_loss",
            "signal_loss": {
              "timeout_minutes": 60
            }
          }
        ]
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
