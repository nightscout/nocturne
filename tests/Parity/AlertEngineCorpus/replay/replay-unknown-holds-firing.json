      "condition_params": {
        "direction": "below",
        "value": 70
      },
      "auto_resolve_enabled": false,
      "on_unknown": "not_met"
    },
    {
      "id": "00000000-0000-0000-0000-000000000004",
      "name": "rule-4",
      "condition_type": "threshold",
      "condition_params": {
        "direction": "above",
        "value": 180
      },
      "auto_resolve_enabled": false,
      "on_unknown": "met"
    }
  ],
