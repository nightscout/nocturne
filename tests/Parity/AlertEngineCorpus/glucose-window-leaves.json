{
  "schema_version": 1,
  "name": "glucose-window-leaves",
  "description": "glucose_change, glucose_extreme and glucose_count over the recent readings of the newest reading's stream, in a window that ends at the newest reading: a fall of 30 in 15 minutes opens and its clear margin holds it at a fall of 20; a high leaves the 60 minute window exactly one window after it was read; while readings stop, every leaf goes stale; after the stop, a window that holds the stop is unknown by glucose_series, inexact, wherever readings it lacks could change the answer, a change with fewer than two readings in its window is unknown by glucose_series, absent, and a count reads again once its window no longer holds the stop",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "glucose_change",
      "condition_params": {
        "operator": "<=",
        "value": -30,
        "window_minutes": 15,
        "clear_margin": 10
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "glucose_extreme",
      "condition_params": {
        "of": "max",
        "operator": ">",
        "value": 250,
        "window_minutes": 60
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "name": "rule-3",
      "condition_type": "glucose_count",
      "condition_params": {
        "reading": {
          "operator": "<",
          "value": 70
        },
        "window_minutes": 20,
        "count": {
          "operator": ">=",
          "value": 3
        }
      },
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000004",
      "name": "rule-4",
      "condition_type": "glucose_count",
      "condition_params": {
        "reading": {
          "operator": ">",
          "value": 100
        },
        "window_minutes": 30,
        "percent": {
          "operator": ">=",
          "value": 50
        }
      },
      "auto_resolve_enabled": false
    }
  ],
