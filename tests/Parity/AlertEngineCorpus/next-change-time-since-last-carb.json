{
  "schema_version": 1,
  "name": "next-change-time-since-last-carb",
  "description": "time_since_last_carb '<' turns false when the carbs reach the bound",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "time_since_last_carb",
      "condition_params": {
