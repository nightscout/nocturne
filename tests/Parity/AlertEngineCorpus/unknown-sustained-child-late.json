{
  "schema_version": 1,
  "name": "unknown-sustained-child-late",
  "description": "sustained whose child is unknown on its first tick starts no run; the run starts at the first true (12:05) and holds 5 minutes later",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "sustained",
      "condition_params": {
        "minutes": 5,
        "child": {
          "type": "threshold",
          "threshold": {
            "direction": "below",
            "value": 70
          }
        }
      },
      "auto_resolve_enabled": false
    }
  ],
