{
  "schema_version": 1,
  "name": "clock-skew-elapsed-leaves",
  "description": "every leaf measuring now - anchor, anchor at 12:00: 3 minutes ahead and exactly 5 minutes ahead read the elapsed time as zero (staleness == 0, for_minutes 0 and the < bounds hold); 6 minutes ahead every leaf is unknown, the rule holds, clock_anomaly names the anchor, and next_change_at is 11:55, where it comes within the tolerance; behind the clock they measure as before",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "signal_loss",
      "condition_params": {
        "timeout_minutes": 20
      },
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "staleness",
      "condition_params": {
