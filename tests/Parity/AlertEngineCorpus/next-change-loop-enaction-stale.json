{
  "schema_version": 1,
  "name": "next-change-loop-enaction-stale",
  "description": "loop_enaction_stale changes when the last enactment reaches the bound",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "loop_enaction_stale",
      "condition_params": {
        "schema_version": 2,
        "operator": ">=",
        "minutes": 30
      },
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
      "at": "2026-03-02T12:00:00Z",
      "context": {
        "last_aps_enacted_at": "2026-03-02T11:45:00Z",
        "has_ever_aps_cycled": true,
        "has_ever_pump_snapshot": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false
      }
    }
  ]
}
