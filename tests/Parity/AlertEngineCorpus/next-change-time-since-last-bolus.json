{
  "schema_version": 1,
  "name": "next-change-time-since-last-bolus",
  "description": "time_since_last_bolus '>' changes a tick after the bound; no bolus at all is infinitely long ago and has none",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "time_since_last_bolus",
      "condition_params": {
        "operator": ">",
        "minutes": 120
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
