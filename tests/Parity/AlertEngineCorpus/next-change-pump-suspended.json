{
  "schema_version": 1,
  "name": "next-change-pump-suspended",
  "description": "pump_suspended for_minutes changes when the suspension has held; without a pump snapshot it has none",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "pump_suspended",
      "condition_params": {
        "is_active": true,
        "for_minutes": 30
      },
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
      "at": "2026-03-02T12:00:00Z",
      "context": {
        "active_pump_suspension": {
          "started_at": "2026-03-02T11:40:00Z"
        },
        "has_ever_pump_snapshot": true,
        "has_ever_aps_cycled": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false
      }
    },
    {
      "at": "2026-03-02T12:05:00Z",
      "context": {
        "active_pump_suspension": {
          "started_at": "2026-03-02T11:40:00Z"
        },
        "has_ever_aps_cycled": false,
        "has_ever_pump_snapshot": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false
      }
    }
  ]
}
