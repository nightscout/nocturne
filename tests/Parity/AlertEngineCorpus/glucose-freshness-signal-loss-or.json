{
  "schema_version": 1,
  "name": "glucose-freshness-signal-loss-or",
  "description": "or(signal_loss, threshold below 70) during an outage: the stale threshold is unknown, so the root is unknown and holds until signal_loss is true, then true and opens",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "composite",
      "condition_params": {
        "operator": "or",
        "conditions": [
          {
            "type": "signal_loss",
            "signal_loss": {
              "timeout_minutes": 20
            }
          },
          {
            "type": "threshold",
            "threshold": {
              "direction": "below",
              "value": 70
            }
          }
        ]
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
