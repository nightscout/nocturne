{
  "schema_version": 1,
  "name": "next-change-alert-state",
  "description": "alert_state for_minutes changes when the other alert has fired for that long",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "alert_state",
      "condition_params": {
        "alert_id": "00000000-0000-0000-0000-0000000000aa",
        "state": "firing",
        "for_minutes": 15
      },
      "auto_resolve_enabled": false
    }
  ],
  "ticks": [
    {
      "at": "2026-03-02T12:00:00Z",
      "context": {
        "active_alerts": [
          {
            "alert_id": "00000000-0000-0000-0000-0000000000aa",
            "state": "firing",
            "triggered_at": "2026-03-02T11:50:00Z"
          }
        ],
        "has_ever_aps_cycled": false,
        "has_ever_pump_snapshot": false,
        "has_ever_uploader_snapshot": false,
        "has_ever_aps_sensitivity": false,
        "sleep_session_active": false
      }
    }
  ]
}
