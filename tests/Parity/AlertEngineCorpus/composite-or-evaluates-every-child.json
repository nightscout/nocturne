{
  "schema_version": 1,
  "name": "composite-or-evaluates-every-child",
  "description": "an OR evaluates every child after one is true, so a sustained sibling\u0027s timer starts on that tick and both row orders agree",
  "rules": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "rule-1",
      "condition_type": "composite",
      "condition_params": {
        "operator": "or",
        "conditions": [
          {
            "type": "threshold",
            "threshold": {
              "direction": "below",
              "value": 70
            }
          },
          {
            "type": "sustained",
            "sustained": {
              "minutes": 5,
              "child": {
                "type": "trend",
                "trend": {
                  "bucket": "falling"
                }
              }
            }
          }
        ]
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "rule-2",
      "condition_type": "composite",
      "condition_params": {
        "operator": "or",
        "conditions": [
          {
            "type": "sustained",
            "sustained": {
              "minutes": 5,
              "child": {
                "type": "trend",
                "trend": {
                  "bucket": "falling"
                }
              }
            }
          },
          {
            "type": "threshold",
            "threshold": {
              "direction": "below",
              "value": 70
            }
          }
        ]
      },
      "confirmation_readings": 1,
      "hysteresis_minutes": 0,
      "auto_resolve_enabled": false
    }
  ],
